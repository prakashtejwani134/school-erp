# Copy this file to `.env` and fill in real values. Never commit `.env` itself —
# it's already gitignored (see `.gitignore`).
#
# Environment variables declared here are NOT automatically loaded by Prisma.
# prisma.config.ts already imports "dotenv/config" so these are loaded for the Prisma CLI.

# Supabase connection strings.
# See: https://supabase.com/docs/guides/database/prisma
#
# Fill in [PROJECT-REF], [PASSWORD], and [REGION] from
# Supabase Dashboard -> Project Settings -> Database -> Connection String.

# Pooled connection (Supavisor, port 6543) — used by the app at runtime via the
# driver adapter in lib/prisma.ts. Required for serverless/edge to avoid exhausting
# Postgres connections.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — required by `prisma migrate` since pooled/PgBouncer
# connections don't support the prepared statements migrations need.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"
