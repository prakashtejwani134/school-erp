datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DIRECTOR
  ADMIN
  TEACHER
  PARENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools             UserSchool[]
  auditLogs           AuditLog[]
  /// Students this user is the parent/guardian of (see `Student.guardianId`).
  guardianOf          Student[]    @relation("StudentGuardian")
  /// Concessions this user approved (see `Student.concessionApprovedBy`).
  concessionsApproved Student[]    @relation("StudentConcessionApproval")
  circulars           Circular[]
  homework            Homework[]

  @@index([email])
}

/// Per-user, per-school membership — a user can belong to more than one
/// school (branch), and their role can differ between them (e.g. Director
/// at one campus, Teacher at another).
model UserSchool {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId, role])
}

model Class {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  section   String
  createdAt DateTime @default(now())

  students Student[]
  homework Homework[]
  exams    Exam[]

  @@index([schoolId])
}

model Student {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo  String   @unique
  firstName    String
  lastName     String
  parentPhone  String
  address      String?
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  isDiscounted Boolean  @default(false)
  createdAt    DateTime @default(now())

  /// Linked parent/guardian account (User with a PARENT `UserSchool`
  /// membership at this student's school) — nullable because most students
  /// won't have a self-service portal account set up yet.
  guardianId String?
  guardian   User?   @relation("StudentGuardian", fields: [guardianId], references: [id])

  /// Why the fee discount (`isDiscounted`) was granted — required whenever
  /// `isDiscounted` is set, enforced in the Server Action rather than here
  /// since Prisma has no conditional-required-field constraint.
  concessionReason     String?
  concessionApprovedBy String?
  concessionApprover   User?     @relation("StudentConcessionApproval", fields: [concessionApprovedBy], references: [id])
  /// When the concession was (most recently) granted — lets the Director's
  /// daily digest report "concessions given today" instead of every
  /// discounted student ever.
  concessionGrantedAt  DateTime?

  feeDues     FeeDue[]
  feeReceipts FeeReceipt[]
  attendances Attendance[]
  marks       Mark[]

  @@index([schoolId, classId])
  @@index([admissionNo])
  @@index([guardianId])
  @@index([concessionApprovedBy])
  @@index([concessionGrantedAt])
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

model FeeStructure {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  classId   String
  createdAt DateTime @default(now())

  feeDues FeeDue[]

  @@index([schoolId])
}

model FeeDue {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  dueAmount      Float
  amountPaid     Float        @default(0)
  isPaid         Boolean      @default(false)

  feeReceipts FeeReceipt[]

  @@index([studentId, isPaid])
  @@index([schoolId, isPaid])
}

model FeeReceipt {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  receiptNo     String      @unique
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  feeDueId      String
  feeDue        FeeDue      @relation(fields: [feeDueId], references: [id])
  paidAmount    Float
  paymentMode   PaymentMode
  collectedBy   String
  transactionId String?
  createdAt     DateTime    @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@index([schoolId, createdAt])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Attendance {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)

  @@unique([studentId, date])
  @@index([date])
  @@index([schoolId, date])
}

enum AuditActionType {
  FEE_COLLECTED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_DELETED
  ATTENDANCE_MARKED
  SETTINGS_UPDATED
  FEE_CATEGORY_CREATED
  FEE_CATEGORY_UPDATED
  FEE_CATEGORY_DELETED
  EXAM_CREATED
  MARKS_ENTERED
}

model AuditLog {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  actionType   AuditActionType
  targetEntity String
  targetId     String?
  details      String
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([actionType])
  @@index([targetEntity])
  @@index([schoolId, createdAt])
}

/// The tenant root. Every school-owned row hangs off this via `schoolId`.
model School {
  id                  String   @id @default(cuid())
  /// Short unique slug (e.g. "GWS") used to namespace human-facing sequences
  /// like receipt numbers, so two schools' locally-counted sequences can
  /// never collide on the global `FeeReceipt.receiptNo` unique constraint.
  code                String   @unique
  schoolName          String
  logoUrl             String?
  address             String
  phone               String
  email               String
  currency            String   @default("USD")
  currentAcademicYear String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships   UserSchool[]
  classes       Class[]
  students      Student[]
  feeStructures FeeStructure[]
  feeDues       FeeDue[]
  feeReceipts   FeeReceipt[]
  attendances   Attendance[]
  auditLogs     AuditLog[]
  feeCategories FeeCategoryRule[]
  circulars     Circular[]
  homework      Homework[]
  subjects      Subject[]
  exams         Exam[]
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model FeeCategoryRule {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  amount            Float
  frequency         FeeFrequency
  lateFeePercentage Float        @default(0.0)
  createdAt         DateTime     @default(now())

  @@index([schoolId])
}

/// School-wide notice, e.g. a holiday announcement or PTA meeting notice.
/// Visible to every parent at the school, so it's scoped by schoolId only
/// (no class/student targeting) — matching the broadcast nature of a circular.
model Circular {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  body        String
  publishedAt DateTime @default(now())
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, publishedAt])
}

/// Assigned to a whole class (Class already fans out to every enrolled
/// Student), so parents see homework for their child via the child's
/// classId rather than a direct per-student assignment.
model Homework {
  id          String   @id @default(uuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  title       String
  description String
  dueDate     DateTime
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([classId])
  @@index([schoolId, dueDate])
}

/// A gradeable subject (e.g. "Mathematics"). Deliberately just a name —
/// no per-class or per-grade-level variation in this phase.
model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  marks Mark[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

/// A single exam sitting (e.g. "Mid-Term 2026") for one class. Marks are
/// always entered per (exam, subject, student) — see `Mark`.
model Exam {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  examDate  DateTime
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())

  marks Mark[]

  @@index([schoolId])
  @@index([classId])
}

/// One student's score in one subject of one exam. `maxMarks` is stored
/// per row (not on `Exam`/`Subject`) so a subject's max can differ between
/// sittings without a migration.
model Mark {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  marksObtained Float
  maxMarks      Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId, subjectId])
  @@index([studentId])
  @@index([examId])
}
