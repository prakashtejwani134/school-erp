datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DIRECTOR
  ADMIN
  TEACHER
  PARENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools   UserSchool[]
  auditLogs AuditLog[]

  @@index([email])
}

/// Per-user, per-school membership — a user can belong to more than one
/// school (branch), and their role can differ between them (e.g. Director
/// at one campus, Teacher at another).
model UserSchool {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([userId, role])
}

model Class {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  section   String
  createdAt DateTime @default(now())

  students Student[]

  @@index([schoolId])
}

model Student {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionNo  String   @unique
  firstName    String
  lastName     String
  parentPhone  String
  address      String?
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  isDiscounted Boolean  @default(false)
  createdAt    DateTime @default(now())

  feeDues     FeeDue[]
  feeReceipts FeeReceipt[]
  attendances Attendance[]

  @@index([schoolId, classId])
  @@index([admissionNo])
}

enum PaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

model FeeStructure {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  dueDate   DateTime
  classId   String
  createdAt DateTime @default(now())

  feeDues FeeDue[]

  @@index([schoolId])
}

model FeeDue {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  dueAmount      Float
  amountPaid     Float        @default(0)
  isPaid         Boolean      @default(false)

  feeReceipts FeeReceipt[]

  @@index([studentId, isPaid])
  @@index([schoolId, isPaid])
}

model FeeReceipt {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  receiptNo     String      @unique
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  feeDueId      String
  feeDue        FeeDue      @relation(fields: [feeDueId], references: [id])
  paidAmount    Float
  paymentMode   PaymentMode
  collectedBy   String
  transactionId String?
  createdAt     DateTime    @default(now())

  @@index([studentId])
  @@index([createdAt])
  @@index([schoolId, createdAt])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Attendance {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)

  @@unique([studentId, date])
  @@index([date])
  @@index([schoolId, date])
}

enum AuditActionType {
  FEE_COLLECTED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_DELETED
  ATTENDANCE_MARKED
  SETTINGS_UPDATED
  FEE_CATEGORY_CREATED
  FEE_CATEGORY_UPDATED
  FEE_CATEGORY_DELETED
}

model AuditLog {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  actionType   AuditActionType
  targetEntity String
  targetId     String?
  details      String
  ipAddress    String?
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([actionType])
  @@index([targetEntity])
  @@index([schoolId, createdAt])
}

/// The tenant root. Every school-owned row hangs off this via `schoolId`.
model School {
  id                  String   @id @default(cuid())
  /// Short unique slug (e.g. "GWS") used to namespace human-facing sequences
  /// like receipt numbers, so two schools' locally-counted sequences can
  /// never collide on the global `FeeReceipt.receiptNo` unique constraint.
  code                String   @unique
  schoolName          String
  logoUrl             String?
  address             String
  phone               String
  email               String
  currency            String   @default("USD")
  currentAcademicYear String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships   UserSchool[]
  classes       Class[]
  students      Student[]
  feeStructures FeeStructure[]
  feeDues       FeeDue[]
  feeReceipts   FeeReceipt[]
  attendances   Attendance[]
  auditLogs     AuditLog[]
  feeCategories FeeCategoryRule[]
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model FeeCategoryRule {
  id                String       @id @default(cuid())
  schoolId          String
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String
  amount            Float
  frequency         FeeFrequency
  lateFeePercentage Float        @default(0.0)
  createdAt         DateTime     @default(now())

  @@index([schoolId])
}
